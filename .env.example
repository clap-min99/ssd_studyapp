DJANGO_SECRET_KEY=local-development-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DATABASE_URL=sqlite:///db.sqlite3

# Real keys belong only in .env / GitHub Secrets / Secret Manager.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional overrides; blank values use OPENAI_MODEL.
OPENAI_PARSE_MODEL=
OPENAI_EXPLAIN_MODEL=
OPENAI_REVIEW_MODEL=
OPENAI_TAG_MODEL=
